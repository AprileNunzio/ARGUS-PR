[Unit]
Description=ARGUS-PR Network Video Recorder
Documentation=https://github.com/AprileNunzio/ARGUS-PR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=argus
Group=argus
WorkingDirectory=/opt/argus-pr
ExecStart=/usr/bin/node /opt/argus-pr/bin/argus.js serve
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

Environment=NODE_ENV=production
Environment=ARGUS_HOST=0.0.0.0
Environment=ARGUS_PORT=8088
Environment=ARGUS_DATA_DIR=/var/lib/argus-pr
Environment=ARGUS_MEDIA_DIR=/var/lib/argus-pr/media
Environment=ARGUS_LOG_LEVEL=info

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/argus-pr
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=argus-pr

[Install]
WantedBy=multi-user.target
