polkit.addRule(function(action, subject) {
    var managed = [
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.systemd1.manage-units"
    ];

    if (subject.user !== "argus") return polkit.Result.NOT_HANDLED;
    if (managed.indexOf(action.id) < 0) return polkit.Result.NOT_HANDLED;

    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var allowed = [
            "argus-pr.service",
            "argus-kiosk.service",
            "argus-pr-kiosk.service",
            "argus-shield.service"
        ];
        if (allowed.indexOf(unit) < 0) return polkit.Result.NOT_HANDLED;
    }

    return polkit.Result.YES;
});
